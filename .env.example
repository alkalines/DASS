# Copy to .env at the repository root for the experimental TLS LAN setup.
# Resource limits and LAN admission settings seed SQLite ONCE. After first
# startup, change them in /admin/settings and restart the backend.
# Existing policy.json, DASS_USERS and DASS_ADMIN_USERS are imported once too.
# Without .env, Compose runs loopback-only plaintext setup/discovery (no media).
# Replace this example IP with the server's actual private LAN IPv4.
DASS_BIND_IP=0.0.0.0
DASS_LAN_SERVER_IPV4=0.0.0.0
DASS_INSECURE_LOCAL_DEV=false
DASS_RTC_SPIKE=true
DASS_RTC_AUTO_LAN_PEERS=true

# Exactly two shared UDP ports, independent of client/session count.
# The backend derives the second as FIRST_PORT + 1. When changing the first,
# update Docker/NAT/firewall mappings for the same pair (see docs).
DASS_RTC_FIRST_PORT=50000
# For more media capacity, change /admin/settings on existing installations;
# no additional UDP ports are needed.
# New databases only (existing SQLite settings take precedence):
DASS_MAX_MEDIA_SESSIONS=4

# Public Internet deployment (roadmap section 4). "local" is the LAN test
# environment only; "public" requires TLS, a globally routable advertised
# media address and no LAN allowlists:
#   DASS_TRANSPORT_MODE=public
#   DASS_INSECURE_LOCAL_DEV=false
#   DASS_LAN_SERVER_IPV4=<public IPv4 of the media server>
#   DASS_RTC_AUTO_LAN_PEERS=false
#   DASS_RTC_ALLOWED_PEERS=
#   DASS_RTC_TRUSTED_CLIENT_IPS=
# The public deployment also needs the UDP media port published by the
# firewall and a trusted certificate; see docs/public-transport.md.

# Authentication and TLS paths go in .secrets/backend.env, NOT here.
# See docs/lan-accounts.md for generating users and that private file.
# Static invite-based tests instead set AUTO_LAN_PEERS=false and explicitly set:
# DASS_RTC_ALLOWED_PEERS=X.X.X.2:54321
# DASS_RTC_TRUSTED_CLIENT_IPS=X.X.X.2
